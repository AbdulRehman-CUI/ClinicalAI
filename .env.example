# Copy this file to .env for local development. Keep real secrets out of git.

# Core application (string)
ENVIRONMENT=development
PROJECT_NAME=ClinicalAI
API_VERSION=0.1.0
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
BACKEND_HOST=127.0.0.1
PORT=8000
BACKEND_PORT=8000
DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=dev-jwt-secret-change-in-production
TIMEZONE=UTC
DATE_FORMAT=%Y-%m-%d

# Logging (string)
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s

# Database (string/int)
DATABASE_URL=sqlite:///./backend/data/clinicalai.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# CORS (string/list)
#ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
#CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
FRONTEND_URL=http://localhost:5173

# File uploads (string/int/list)
UPLOAD_DIRECTORY=backend/data/uploads
MAX_UPLOAD_SIZE_MB=20
MAX_UPLOAD_SIZE=20

ALLOWED_FILE_EXTENSIONS=["PDF","DOCX","TXT","PNG","JPG","JPEG"]
#ALLOWED_FILE_EXTENSIONS=PDF,DOCX,TXT,PNG,JPG,JPEG
ALLOWED_FILE_TYPES=["PDF","DOCX","TXT","PNG","JPG","JPEG"]
#ALLOWED_FILE_TYPES=PDF,DOCX,TXT,PNG,JPG,JPEG

# AI integration (string/float/int)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT=60
MAX_AI_TOKENS=2048
MAX_REPORT_SIZE=10
MAX_CONTEXT_LENGTH=12000

# OCR (string/int)
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT=60

# Storage (string)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=backend/data/storage

# Pagination (int)
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Frontend build/runtime
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api/v1

